{
  "name": "@tollgate/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audit-hash": {
      "types": "./dist/audit-hash.d.ts",
      "default": "./dist/audit-hash.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "dev": "echo '@tollgate/contracts: no dev task yet'",
    "openapi": "tsx openapi/generate.ts",
    "mock:api": "tsx mocks/server.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
