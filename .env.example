# PayPal sandbox app credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live — always sandbox for this project
PAYPAL_ENV=sandbox
# Webhook ID from the PayPal sandbox app's webhook subscription, used to verify signatures
PAYPAL_WEBHOOK_ID=

# Postgres connection string used by packages/db (Drizzle)
DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate

# OpenAI-compatible LLM endpoint for the AI guard and policy compiler
# Defaults to a local Ollama instance
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct

# ntfy server + topic used to push hold/approval notifications
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Dashboard operator login password
ADMIN_PASSWORD=
# Secret used to sign dashboard session cookies
SESSION_SECRET=
# Secret used to sign one-time approval links sent via ntfy
APPROVAL_TOKEN_SECRET=

# Public base URL of the gateway (used to build approval links, webhooks)
PUBLIC_BASE_URL=http://localhost:4000
# Base URL of the dashboard app
DASHBOARD_URL=http://localhost:3000
